        "368531641": {
          "id": 368531641,
          "account_id": 0,
          "customuser_id": 0,
          "paused": true,
          "type_of": "write",
          "params": {
            "input": {
              "query_output": "{{368531629__output}}",
              "response_output": "{{368531630__output}}"
            },
            "packages_enabled": false,
            "code": "const validClasses = ['SENSITIVE', 'STANDARD', 'UNCERTAIN'];\n\n// Parse the query classification JSON\nlet queryData = {};\ntry {\n  queryData = typeof inputData.query_output === 'string' \n    ? JSON.parse(inputData.query_output) \n    : inputData.query_output;\n} catch (e) {\n  queryData = { class: 'UNCERTAIN', domain: 'NONE' };\n}\n\n// Parse the response classification JSON\nlet responseData = {};\ntry {\n  responseData = typeof inputData.response_output === 'string' \n    ? JSON.parse(inputData.response_output) \n    : inputData.response_output;\n} catch (e) {\n  responseData = { class: 'UNCERTAIN', domain: 'NONE' };\n}\n\n// Validate and override (fail-closed: invalid values become SENSITIVE)\nconst queryClass = validClasses.includes(queryData.class) ? queryData.class : 'SENSITIVE';\nconst queryDomain = queryData.domain || 'NONE';\n\nconst responseClass = validClasses.includes(responseData.class) ? responseData.class : 'SENSITIVE';\nconst responseDomain = responseData.domain || 'NONE';\n\nreturn {\n  query_class: queryClass,\n  query_domain: queryDomain,\n  response_class: responseClass,\n  response_domain: responseDomain,\n  validated: true\n};"
          },
