    "369352849": {
      "id": 369352849,
      "account_id": 0,
      "customuser_id": 0,
      "paused": true,
      "type_of": "write",
      "params": {
        "authentication_id": "0",
        "model_id": "standard/auto",
        "provider_id": "",
        "instructions": "Based on the document category provided below, return a JSON object containing:\n\n1. A `category` field echoing back the classification you were given.\n2. ONLY the relevant metadata fields for that category (schema below).\n\nDocument category: {{=gives[\"369352233\"][\"category\"]}}\n\nDocument text:/{{=gives['369362192'][\"body\"]}}\n\nSchema by category:\n\n- Funding Doc: funder_name, recipient_name, award_amount, program_name, key_terms\n- Contract: vendor, customer, effective_date, expiration_date, contract_value, key_services, governing_law\n- Invoice: vendor, customer, invoice_number, invoice_date, due_date, total_amount, line_items (as array of {description, quantity, unit_price, amount}), payment_status\n- Certificate: certificate_holder, issuer, certification_name, cert_type, issue_date, expiration_date, credential_id\n- Review: return {\"category\": \"Review\"} with no other fields.\n\nRules:\n- Use null for missing or unknown values.\n- DO NOT include fields from other categories.\n- Return ONLY the JSON object. No prose, no markdown fences.",
        "inputFields": {
          "document_text": "{{369352155__extracted_text}}",
          "document_category": "{{369352233__category}}"
        },
        "outputSchema": {
          "extracted_metadata": "JSON object containing extracted metadata fields based on document category"
        },
        "isOutputArray": false
      },
      "meta": {
        "$editor": {
          "has_automatic_issues": true
        },
        "parammap": {}
      },
