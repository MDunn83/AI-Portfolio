          "params": {
            "api_branch_name": "",
            "provider_id": "openai",
            "model_id": "openai/gpt-4.1",
            "instructions": "You are an HR specialist. Generate onboarding content for a new employee. Create exactly these 4 items:\n\n1. A warm welcome email (brief, 2-3 sentences)\n2. A 30/60/90 day plan (bullet points for each phase)\n3. 4-5 manager action items (specific, numbered list)\n4. A 30-day manager agenda (key milestones/check-ins)\n\nNew Hire: {{369490443__COL$A}} {{369490443__COL$B}}\nRole: {{369490443__COL$C}}\nDepartment: {{369490443__COL$D}}\nStart Date: {{369490443__COL$E}}\nManager: {{369490443__COL$F}}\nPlan Tier: {{369490443__COL$I}}\n\nFormat your response with clear section headers: WELCOME_EMAIL, PLAN_30_60_90, MANAGER_ACTIONS, MANAGER_AGENDA",
            "inputFields": {
              "first_name": "{{369490443__COL$A}}",
              "last_name": "{{369490443__COL$B}}",
              "role": "{{369490443__COL$C}}",
              "department": "{{369490443__COL$D}}",
              "start_date": "{{369490443__COL$E}}",
              "manager": "{{369490443__COL$F}}",
              "manager_email": "{{369490443__COL$G}}",
              "contact_email": "{{369490443__COL$H}}",
              "plan_tier": "{{369490443__COL$I}}"
            },
            "outputSchema": {
              "welcome_email": "The welcome email text for the new hire",
              "plan_30_60_90": "The 30/60/90 day onboarding plan",
              "manager_action_items": "Comma-separated list of 4-5 specific action items for the manager",
              "manager_agenda": "30-day manager agenda with key checkpoints"
