    "369353155": {
      "id": 369353155,
      "account_id": 0,
      "customuser_id": 0,
      "paused": true,
      "type_of": "write",
      "params": {
        "input": {
          "extracted_metadata": "{{=gives[\"369352849\"][\"extracted_metadata\"]}}",
          "classifier_raw": "{{=Object.to_json(output[\"369352233\"])}}"
        },
        "packages_enabled": false,
        "code": "// Get inputs from upstream steps\nconst rawInput = inputData.extracted_metadata || inputData.result || JSON.stringify(inputData);\nconst classifierRaw = inputData.classifier_raw || '';\n\nfunction tryParse(value) {\n  if (typeof value !== 'string') return value;\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    const match = value.match(/\\{[\\s\\S]*\\}/);\n    if (match) {\n      try { return JSON.parse(match[0]); } catch (e2) { return null; }\n    }\n    return null;\n  }\n}\n\nconst classifierParsed = tryParse(classifierRaw);\nconst classifierCategory = (classifierParsed && classifierParsed.category) || '';\nconst classifierConfidence = (classifierParsed && classifierParsed.confidence) || '';\nconst classifierReasoning = (classifierParsed && classifierParsed.reasoning) || '';\n\nlet metadata = tryParse(rawInput) || {};\nif (metadata && metadata.extracted_metadata) {\n  const inner = tryParse(metadata.extracted_metadata);\n  if (inner) metadata = inner;\n}\n\nconst category = metadata.category || classifierCategory || '';\nconst confidence = metadata.confidence || classifierConfidence || '';\nconst reasoning = metadata.reasoning || classifierReasoning || '';\n\n// Line items handling for invoices\nlet lineItemsArray = [];\nlet lineItemsJson = '';\nif (Array.isArray(metadata.line_items)) {\n  lineItemsArray = metadata.line_items;\n  lineItemsJson = JSON.stringify(metadata.line_items);\n}\n\n// Explicit schema \u2014 every possible field declared, null if not applicable\nreturn {\n  // Shared fields\n  category: category,\n  confidence: confidence,\n  reasoning: reasoning,\n\n  // Funding Doc fields\n  funder_name: metadata.funder_name || '',\n  recipient_name: metadata.recipient_name || '',\n  award_amount: metadata.award_amount || '',\n  program_name: metadata.program_name || '',\n  key_terms: metadata.key_terms || '',\n\n  // Contract fields\n  vendor: metadata.vendor || '',\n  customer: metadata.customer || '',\n  effective_date: metadata.effective_date || '',\n  expiration_date: metadata.expiration_date || '',\n  contract_value: metadata.contract_value || '',\n  key_services: metadata.key_services || '',\n  governing_law: metadata.governing_law || '',\n\n  // Invoice fields\n  invoice_number: metadata.invoice_number || '',\n  invoice_date: metadata.invoice_date || '',\n  due_date: metadata.due_date || '',\n  total_amount: metadata.total_amount || '',\n  payment_status: metadata.payment_status || '',\n  line_items_json: lineItemsJson,\n  line_items_array: lineItemsArray,\n\n  // Certificate fields\n  certificate_holder: metadata.certificate_holder || '',\n  issuer: metadata.issuer || '',\n  certification_name: metadata.certification_name || '',\n  cert_type: metadata.cert_type || '',\n  issue_date: metadata.issue_date || '',\n\n  // Shared with multiple categories \u2014 only one will actually have a value\n  credential_id: metadata.credential_id || ''\n};"
      },
