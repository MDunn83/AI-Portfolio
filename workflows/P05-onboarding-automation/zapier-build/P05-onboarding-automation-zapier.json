        "369490982": {
          "id": 369490982,
          "account_id": 0,
          "customuser_id": 0,
          "paused": true,
          "type_of": "write",
          "params": {
            "input": {
              "manager_action_items": "{{369490444__manager_action_items}}",
              "start_date": "{{369490443__COL$E}}",
              "first_name": "{{369490443__COL$A}}",
              "last_name": "{{369490443__COL$B}}",
              "manager": "{{369490443__COL$F}}"
            },
            "packages_enabled": false,
            "code": "import re\nfrom datetime import datetime, timedelta\n\nmanager_action_items = input_data.get('manager_action_items', '') or ''\nstart_date = input_data.get('start_date', '')\nfirst_name = input_data.get('first_name', '')\nlast_name = input_data.get('last_name', '')\nmanager = input_data.get('manager', '')\n\n# Split the numbered list on its \"1.\" \"2.\" markers, NOT on internal commas.\nparts = re.split(r'(?:^|\\s)\\d+\\.\\s+', manager_action_items)\naction_items = [p.strip() for p in parts if p.strip()]\n\n# Fallback to newline split if the items weren't numbered.\nif len(action_items) <= 1:\n    action_items = [line.strip(' -\\t') for line in manager_action_items.splitlines() if line.strip()]\n\n# Base date for due-date math.\ntry:\n    start_dt = datetime.strptime(start_date, '%Y-%m-%d')\nexcept (ValueError, TypeError):\n    start_dt = datetime.now()\n\ndef due_for(item):\n    # Honor the phase the item references (30/60/90 days); default to 30.\n    if '90' in item:\n        days = 90\n    elif '60' in item:\n        days = 60\n    else:\n        days = 30\n    return (start_dt + timedelta(days=days)).strftime('%Y-%m-%d')\n\ntasks = []\nfor item in action_items:\n    tasks.append({\n        'title': f\"{item} - for {first_name} {last_name}\",\n        'description': item,\n        'due_date': due_for(item),\n        'manager': manager\n    })\n\nreturn {\n    'tasks_created': len(tasks),\n    'status': 'success' if tasks else 'no_items',\n    'tasks': tasks\n}"
          },
