        "367792046": {
          "id": 367792046,
          "account_id": 0,
          "customuser_id": 0,
          "paused": true,
          "type_of": "write",
          "params": {
            "input": {
              "summary": "{{367553974__summary}}",
              "action_items": "{{367553974__action_items}}",
              "decisions": "{{367553974__decisions}}",
              "open_questions": "{{367553974__open_questions}}",
              "participants": "{{367553974__participants}}"
            },
            "packages_enabled": false,
            "code": "const fields = ['summary', 'action_items', 'decisions', 'open_questions', 'participants'];\nlet hasDegradation = false;\nconst validatedData = {};\n\nfields.forEach(field => {\n  const value = inputData[field] || '';\n  if (!value.trim()) {\n    validatedData[field] = 'unavailable';\n    hasDegradation = true;\n  } else {\n    validatedData[field] = value;\n  }\n});\n\n// Fix: Normalize action_items to ensure clean loop splitting\nif (validatedData.action_items !== 'unavailable' && validatedData.action_items !== 'None') {\n  // Trim whitespace first\n  let items = validatedData.action_items.trim();\n  // Split by newline, filter for lines starting with \"- \", and rejoin cleanly\n  const lines = items.split('\\n')\n    .map(line => line.trim())\n    .filter(line => line.length > 0 && line.startsWith('- '));\n  // Rejoin with clean delimiter\n  validatedData.action_items = lines.join('\\n');\n}\n\nvalidatedData.has_degradation = hasDegradation;\nreturn validatedData;"
          },
