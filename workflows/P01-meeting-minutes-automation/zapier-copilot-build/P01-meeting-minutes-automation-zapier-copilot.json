          "paused": true,
          "type_of": "write",
          "params": {
            "provider_id": "openai",
            "authentication_id": "0",
            "model_id": "openai/gpt-4o-mini",
            "isOutputArray": false,
            "instructions": "You are a meeting minutes parser. Extract and structure the following from the meeting notes and return as plain text (NOT JSON arrays):\n\n1. SUMMARY: A concise 2-3 sentence overview of the meeting's main topic and context.\n\n2. ACTION_ITEMS: A bulleted list of specific tasks with owners assigned. Format each on a new line as: - Owner: Task description (due date if stated)\n   - Preserve due dates VERBATIM as stated in the transcript (e.g., \"by Friday after next\", \"before the demo\", \"end of next week\"). Do NOT normalize to ISO dates.\n   - Omit due dates that were not explicitly stated.\n   - If the meeting contained NO action items, return the literal text: None\n   - Do NOT include personal logistics, social asides, or pleasantries.\n\n3. DECISIONS: A bulleted list of key decisions. Format each on a new line as: - Decision statement\n   - If the meeting contained NO decisions, return the literal text: None\n   - Do NOT include personal logistics, social asides, or pleasantries.\n\n4. OPEN_QUESTIONS: A bulleted list of unresolved questions, blockers, or open issues. Format each on a new line as: - Question/blocker statement\n   - If there were NO open questions or blockers, return the literal text: None\n   - Do NOT include personal logistics, social asides, or pleasantries.\n\n5. PARTICIPANTS: Comma-separated list of attendee names mentioned in the meeting.\n   - Preserve names EXACTLY as written, including diacritics and unusual spellings. Do NOT anglicize or normalize.\n   - If a name appears multiple times with different spellings, use the FIRST instantiation.\n\nIMPORTANT: Filter out side conversations unrelated to the meeting's stated purpose (personal logistics, pleasantries, birthday plans, social asides, off-topic comments). If you would not include it in a recap email to a non-attendee, exclude it from every field.\n\nReturn the extracted data as a structured object with these 5 fields, using plain text (not JSON arrays) for the lists.",
            "inputFields": {
              "meeting_minutes": "{{367553971__COL$B}}",
              "timestamp": "{{367553971__COL$A}}"
            },
            "outputSchema": {
              "summary": "A 2-3 sentence summary of the meeting's main focus and context",
              "action_items": "Bulleted list of action items with owners (plain text, not JSON array)",
              "decisions": "Bulleted list of key decisions (plain text, not JSON array)",
              "open_questions": "Bulleted list of questions/blockers (plain text, not JSON array)",
              "participants": "Comma-separated list of attendees"
            },
            "content_moderation": false
          },
