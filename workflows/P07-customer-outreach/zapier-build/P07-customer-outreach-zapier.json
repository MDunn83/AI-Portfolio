              "email": "{{368950875__email}}",
              "plan_tier": "{{368950875__plan_tier}}"
            },
            "packages_enabled": false,
            "code": "// Get today's date in UTC\nconst today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\n\n// Helper function to parse date strings (YYYY-MM-DD) to Date objects\nfunction parseDate(dateStr) {\n  if (!dateStr || dateStr.trim() === '') return null;\n  const [year, month, day] = dateStr.trim().split('-');\n  const date = new Date(Date.UTC(parseInt(year), parseInt(month) - 1, parseInt(day)));\n  return date;\n}\n\n// Helper function to calculate days between two dates\nfunction daysBetween(date1, date2) {\n  const msPerDay = 24 * 60 * 60 * 1000;\n  return Math.floor((date2 - date1) / msPerDay);\n}\n\n// Parse input dates\nconst lastContacted = parseDate(inputData.last_contacted);\nconst lastActivity = parseDate(inputData.last_activity);\nconst renewalDate = parseDate(inputData.renewal_date);\nconst ticketDate = parseDate(inputData.ticket_date);\nconst milestone = inputData.milestone || 'No';\n\n// Calculate days since activity and days until renewal\nconst daysSinceActivity = lastActivity ? daysBetween(lastActivity, today) : null;\nconst daysUntilRenewal = renewalDate ? daysBetween(today, renewalDate) : null;\n\n// Determine suppression status\nlet suppressed = false;\nlet category = 'No Action';\n\nif (lastContacted) {\n  const daysSinceContacted = daysBetween(lastContacted, today);\n  if (daysSinceContacted <= 7) {\n    suppressed = true;\n    category = 'Suppressed';\n  }\n}\n\n// If not suppressed, determine priority category\nif (!suppressed) {\n  if (ticketDate) {\n    const daysSinceTicket = daysBetween(ticketDate, today);\n    if (daysSinceTicket <= 1) {\n      category = 'Ticket';\n    } else if (daysSinceActivity > 14) {\n      category = 'Inactivity';\n    } else if (daysUntilRenewal !== null && daysUntilRenewal < 30) {\n      category = 'Renewal';\n    } else if (milestone === 'Yes') {\n      category = 'Milestone';\n    }\n  } else if (daysSinceActivity > 14) {\n    category = 'Inactivity';\n  } else if (daysUntilRenewal !== null && daysUntilRenewal < 30) {\n    category = 'Renewal';\n  } else if (milestone === 'Yes') {\n    category = 'Milestone';\n  }\n}\n\n// Return the output object with all required fields\nreturn {\n  suppressed,\n  category,\n  customer_name: inputData.customer_name || '',\n  company: inputData.company || '',\n  email: inputData.email || '',\n  plan_tier: inputData.plan_tier || '',\n  last_contacted: inputData.last_contacted || '',\n  last_activity: inputData.last_activity || '',\n  renewal_date: inputData.renewal_date || '',\n  ticket_date: inputData.ticket_date || '',\n  milestone: inputData.milestone || '',\n  days_since_activity: daysSinceActivity !== null ? daysSinceActivity : 0,\n  days_until_renewal: daysUntilRenewal !== null ? daysUntilRenewal : 0,\n};"
          },
